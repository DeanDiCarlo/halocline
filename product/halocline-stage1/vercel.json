{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/map",
      "destination": "/map/index.html"
    },
    {
      "source": "/checkpoint",
      "destination": "/checkpoint/index.html"
    }
  ]
}
